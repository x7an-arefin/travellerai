---
import { environment } from '@environments/environment';
import HeaderActionsIsland from './islands/HeaderActionsIsland';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/destinations', label: 'Destinations' },
  { href: '/tours', label: 'Expeditions', badge: 'Curated' },
  { href: '/hotels', label: 'Sanctuaries' },
  { href: '/vehicles', label: 'Fleet & Transfers' },
  { href: '/providers', label: 'Operators' },
  { href: '/blog', label: 'Dispatch' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo: Swiss Modern Bold Typography -->
    <a href="/" class="brand-logo" aria-label="TravellerAI Home">
      <span class="logo-mark">TRAVELLER</span><span class="logo-ai">AI</span>
    </a>

    <!-- Primary Navigation: Serial Position Effect (Key links first and last) -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li class="nav-item">
              <a 
                href={item.href} 
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
                {item.badge && <span class="nav-pill">{item.badge}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions & Utility: Currency, Mode Badge, Cart Drawer & Auth Actions -->
    <div class="header-actions">
      <!-- Data Mode Indicator for pair-programming & demo visibility -->
      <div class="mode-indicator" title={`Running in ${environment.dataMode.toUpperCase()} mode`}>
        <span class="mode-dot"></span>
        <span class="mode-text">{environment.dataMode === 'mock' ? 'MOCK' : 'API'}</span>
      </div>

      <!-- SolidJS Island: Theme Toggle, Currency Selector, Cart Drawer, Mobile Navigation -->
      <HeaderActionsIsland client:load />

      <div class="auth-buttons desktop-only">
        <a href="/account" class="btn btn-secondary btn-sm auth-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Account
        </a>
        <a href="/auth/login" class="btn btn-primary btn-sm login-btn">
          Sign In
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-pure-white);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-stone);
    height: var(--header-height);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .brand-logo {
    display: flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  .logo-mark {
    letter-spacing: -0.03em;
  }

  .logo-ai {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-swiss-accent);
    margin-left: 2px;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 990px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-graphite);
    padding: 6px 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link.active {
    color: var(--color-ink);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-ink);
  }

  .nav-pill {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background-color: var(--color-fog);
    color: var(--color-mist);
    border: 1px solid var(--color-stone);
    text-transform: uppercase;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mode-indicator {
    display: none;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 8px;
    background-color: var(--color-fog);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-full);
    color: var(--color-mist);
  }

  @media (min-width: 640px) {
    .mode-indicator {
      display: flex;
    }
  }

  .mode-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-only {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
  }

  .btn-sm {
    padding: 8px 14px;
    font-size: var(--text-xs);
  }

  /* Global Styles for HeaderActionsIsland */
  :global(.header-island-wrapper) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.icon-btn) {
    background: transparent;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-ink);
    transition: all var(--transition-fast);
    position: relative;
  }

  :global(.icon-btn:hover) {
    background-color: var(--color-fog);
    border-color: var(--color-graphite);
  }

  :global(.currency-mini-select) {
    padding: 6px 8px;
    font-size: 11px;
    font-family: var(--font-mono);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    cursor: pointer;
  }

  :global(.cart-badge-dot) {
    position: absolute;
    top: -4px;
    right: -4px;
    background-color: var(--color-swiss-accent);
    color: #ffffff;
    font-size: 9px;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.mobile-hamburger) {
    display: flex;
  }

  @media (min-width: 990px) {
    :global(.mobile-hamburger) {
      display: none;
    }
  }

  :global(.drawer-overlay) {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 999;
    display: flex;
    justify-content: flex-end;
  }

  :global(.cart-drawer),
  :global(.mobile-nav-drawer) {
    width: 100%;
    max-width: 380px;
    height: 100%;
    background-color: var(--color-pure-white);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-modal);
    animation: slideInRight 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideInRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  :global(.drawer-header) {
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-stone);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  :global(.drawer-header h3) {
    font-size: var(--text-base);
  }

  :global(.close-btn) {
    background: transparent;
    border: none;
    font-size: var(--text-lg);
    cursor: pointer;
    color: var(--color-mist);
  }

  :global(.close-btn:hover) {
    color: var(--color-ink);
  }

  :global(.drawer-body) {
    padding: var(--space-5);
    flex-grow: 1;
    overflow-y: auto;
  }

  :global(.empty-cart-msg) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    padding-top: var(--space-10);
    color: var(--color-mist);
    font-size: var(--text-sm);
  }

  :global(.cart-items-stack) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.cart-item-row) {
    display: flex;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-fog);
  }

  :global(.item-thumb) {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  :global(.item-info) {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 2px;
  }

  :global(.item-type) {
    font-size: 9px;
    font-family: var(--font-mono);
    color: var(--color-swiss-accent);
    font-weight: 700;
  }

  :global(.item-title) {
    font-size: var(--text-xs);
    line-height: 1.3;
  }

  :global(.item-sub) {
    font-size: 11px;
    color: var(--color-mist);
  }

  :global(.item-price-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    font-weight: 700;
    margin-top: 4px;
  }

  :global(.remove-item-btn) {
    background: transparent;
    border: none;
    color: var(--color-error);
    font-size: 11px;
    cursor: pointer;
  }

  :global(.drawer-footer) {
    padding: var(--space-5);
    border-top: 1px solid var(--color-stone);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background-color: var(--color-fog);
  }

  :global(.total-row) {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  :global(.mobile-links-list) {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    gap: var(--space-3);
    flex-grow: 1;
  }

  :global(.mob-link) {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-ink);
    padding: 6px 0;
    border-bottom: 1px solid var(--color-fog);
  }

  :global(.mob-link:hover) {
    color: var(--color-swiss-accent);
  }

  :global(.mobile-drawer-footer) {
    padding: var(--space-5);
    border-top: 1px solid var(--color-stone);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
