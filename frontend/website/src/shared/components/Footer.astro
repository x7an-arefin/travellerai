---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <!-- Top Row: Editorial Mission & Newsletter (Labor illusion + trust) -->
    <div class="footer-top">
      <div class="footer-brand-column">
        <a href="/" class="footer-logo">
          <span>TRAVELLER</span><span class="logo-accent">AI</span>
        </a>
        <p class="brand-tagline">
          The curated multi-provider travel marketplace. Direct bookings with verified local operators, boutique sanctuaries, and executive transport fleets.
        </p>
        <div class="guarantee-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Verified Operator Financial Guarantee</span>
        </div>
      </div>

      <!-- Quick Internal Links Graph for High Domain Authority SEO -->
      <div class="footer-links-grid">
        <div class="link-group">
          <h4 class="group-title">Marketplace</h4>
          <ul>
            <li><a href="/tours">Curated Expeditions</a></li>
            <li><a href="/hotels">Hotels & Chalets</a></li>
            <li><a href="/vehicles">Executive Fleet</a></li>
            <li><a href="/destinations">Global Destinations</a></li>
          </ul>
        </div>

        <div class="link-group">
          <h4 class="group-title">Destinations</h4>
          <ul>
            <li><a href="/destinations/swiss-alps">Swiss Alps & Zermatt</a></li>
            <li><a href="/destinations/kyoto">Kyoto Sanctuaries</a></li>
            <li><a href="/destinations/sylhet">Sylhet Rainforest</a></li>
            <li><a href="/destinations/dolomites">Italian Dolomites</a></li>
          </ul>
        </div>

        <div class="link-group">
          <h4 class="group-title">For Providers</h4>
          <ul>
            <li><a href="http://localhost:4200" target="_blank" rel="noopener">Provider Portal</a></li>
            <li><a href="/about">Platform Standards</a></li>
            <li><a href="/about">Zero Commission Guarantee</a></li>
            <li><a href="/contact">Partner Inquiries</a></li>
          </ul>
        </div>

        <div class="link-group">
          <h4 class="group-title">Legal & Trust</h4>
          <ul>
            <li><a href="/contact">Support & Concierge</a></li>
            <li><a href="/about">Booking Security</a></li>
            <li><a href="/about">Privacy Policy</a></li>
            <li><a href="/about">Terms of Service</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Swiss Modern Alignment -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} TravellerAI Technologies Inc. All rights reserved. Architectural Swiss Modern system.
      </p>
      <div class="system-status">
        <span class="status-indicator"></span>
        <span>Systems Operational • 99.98% Edge Uptime</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-pure-white);
    border-top: 1px solid var(--color-stone);
    margin-top: auto;
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-stone);
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 360px 1fr;
      gap: var(--space-16);
    }
  }

  .footer-brand-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  .logo-accent {
    font-family: var(--font-mono);
    color: var(--color-swiss-accent);
    font-size: 1.1rem;
    margin-left: 2px;
  }

  .brand-tagline {
    font-size: var(--text-sm);
    color: var(--color-mist);
    line-height: 1.6;
  }

  .guarantee-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-graphite);
    padding: 8px 12px;
    background-color: var(--color-fog);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    width: fit-content;
  }

  .guarantee-badge svg {
    color: var(--color-success);
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .footer-links-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .group-title {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    margin-bottom: var(--space-4);
  }

  .link-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .link-group a {
    font-size: var(--text-sm);
    color: var(--color-mist);
    transition: color var(--transition-fast);
  }

  .link-group a:hover {
    color: var(--color-ink);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: space-between;
    align-items: flex-start;
    padding-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-success);
  }
</style>
