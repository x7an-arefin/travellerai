---
import Layout from '@layouts/Layout.astro';
import { getTours } from '@modules/tours/tours.controller';
import TourCard from '@modules/tours/components/TourCard.astro';

const featuredTours = (await getTours()).slice(0, 2);
---

<Layout 
  title="404 — Route Not Found | TravellerAI" 
  description="The travel route or destination page you requested cannot be located."
>
  <div class="error-404-page">
    <div class="container narrow">
      <div class="error-hero">
        <span class="error-code">404</span>
        <span class="editorial-tag">Off The Map</span>
        <h1 class="page-title">You've reached an uncharted trail.</h1>
        <p class="page-lead">
          The route you are looking for has either been relocated, renamed, or retired by the operator.
        </p>

        <div class="recovery-actions">
          <a href="/" class="btn btn-primary btn-lg">
            ← Return to Homepage
          </a>
          <a href="/tours" class="btn btn-secondary btn-lg">
            Explore All Expeditions
          </a>
        </div>
      </div>

      <!-- Suggested Explorations -->
      <section class="suggested-section">
        <h2 class="sec-title">Recommended Expeditions</h2>
        <div class="tours-grid">
          {featuredTours.map((t) => (
            <TourCard tour={t} />
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .error-404-page {
    padding-top: var(--space-16);
    padding-bottom: var(--space-24);
  }

  .narrow {
    max-width: var(--container-narrow);
  }

  .error-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    margin-bottom: var(--space-16);
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-stone);
    letter-spacing: -0.05em;
  }

  .page-title {
    font-size: var(--text-hero);
    line-height: 1.1;
  }

  .page-lead {
    font-size: var(--text-base);
    color: var(--color-mist);
    max-width: 520px;
  }

  .recovery-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
    justify-content: center;
  }

  .btn-lg {
    padding: 12px 24px;
    font-size: var(--text-sm);
  }

  .suggested-section {
    border-top: 1px solid var(--color-stone);
    padding-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sec-title {
    font-size: var(--text-2xl);
    text-align: center;
  }

  .tours-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .tours-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
