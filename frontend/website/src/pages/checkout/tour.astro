---
import Layout from '@layouts/Layout.astro';
---

<Layout 
  title="Secure Tour Checkout — TravellerAI" 
  description="Complete your direct reservation with verified operator escrow guarantee."
>
  <div class="checkout-page">
    <div class="container">
      <div class="checkout-header">
        <span class="editorial-tag">Encrypted Reservation</span>
        <h1 class="page-title">Confirm Tour Reservation</h1>
        <div class="trust-pill-row">
          <span class="badge badge-success">🔒 256-bit TLS Escrow</span>
          <span class="badge badge-neutral">0% Aggregator Booking Fee</span>
          <span class="badge badge-neutral">Free Cancellation Policy</span>
        </div>
      </div>

      <div class="checkout-grid">
        <!-- Form Fields -->
        <div class="checkout-form-col">
          <form class="checkout-form" onsubmit="event.preventDefault(); window.location.href = '/checkout/confirmation?type=tour';">
            <section class="form-section">
              <h2 class="sec-title">1. Primary Lead Traveler</h2>
              <div class="fields-row">
                <div class="f-group">
                  <label for="first-name">First Name</label>
                  <input id="first-name" type="text" required placeholder="First Name" />
                </div>
                <div class="f-group">
                  <label for="last-name">Last Name</label>
                  <input id="last-name" type="text" required placeholder="Last Name" />
                </div>
              </div>
              <div class="fields-row">
                <div class="f-group">
                  <label for="c-email">Email Address</label>
                  <input id="c-email" type="email" required placeholder="email@domain.com" />
                </div>
                <div class="f-group">
                  <label for="c-phone">Mobile Phone (WhatsApp)</label>
                  <input id="c-phone" type="tel" required placeholder="+1 (555) 000-0000" />
                </div>
              </div>
            </section>

            <section class="form-section">
              <h2 class="sec-title">2. Dietary & Special Requests</h2>
              <div class="f-group">
                <label for="special-req">Notes for Mountain Guide / Operator</label>
                <textarea id="special-req" rows="3" placeholder="e.g. Vegetarian diet, altitude acclimatization notes..."></textarea>
              </div>
            </section>

            <section class="form-section">
              <h2 class="sec-title">3. Payment & Escrow Method</h2>
              <div class="payment-tabs">
                <label class="pay-method-pill active">
                  <input type="radio" name="payment" checked />
                  <span>Credit / Debit Card</span>
                </label>
                <label class="pay-method-pill">
                  <input type="radio" name="payment" />
                  <span>Apple Pay</span>
                </label>
              </div>

              <div class="f-group">
                <label for="card-num">Card Number</label>
                <input id="card-num" type="text" placeholder="4242 •••• •••• 4242" value="4242 •••• •••• 4242" />
              </div>
              <div class="fields-row">
                <div class="f-group">
                  <label for="exp">Expiry</label>
                  <input id="exp" type="text" placeholder="MM/YY" value="12/28" />
                </div>
                <div class="f-group">
                  <label for="cvc">CVC</label>
                  <input id="cvc" type="text" placeholder="123" value="888" />
                </div>
              </div>
            </section>

            <button type="submit" class="btn btn-primary btn-lg btn-block">
              Confirm & Authorize Reservation
            </button>
            <p class="micro-guarantee">
              Zero charges today if reserving under the 30-day free cancellation policy.
            </p>
          </form>
        </div>

        <!-- Sticky Order Summary -->
        <aside class="checkout-summary-col">
          <div class="summary-card">
            <h3 class="summary-title">Reservation Summary</h3>
            <div class="product-thumb">
              <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=400&auto=format&fit=crop" alt="Swiss Alps" />
              <div>
                <span class="prod-type">Expedition Departure</span>
                <h4 class="prod-name">Swiss Alpine Odyssey & Glacier Express</h4>
                <span class="prod-date">Oct 12 – Oct 18, 2026 (7 Days)</span>
              </div>
            </div>

            <div class="cost-breakdown">
              <div class="line">
                <span>Standard Package (2 Travelers)</span>
                <span>$6,900.00</span>
              </div>
              <div class="line">
                <span>Luggage Transit Add-on</span>
                <span>$300.00</span>
              </div>
              <div class="line">
                <span>Marketplace Booking Fee</span>
                <span class="free-tag">$0.00 (FREE)</span>
              </div>
              <div class="line total-line">
                <strong>Total Amount:</strong>
                <strong>$7,200.00 USD</strong>
              </div>
            </div>

            <div class="operator-badge-box">
              <span>Verified Operator: <strong>Helvetia Alpine Expeditions</strong></span>
              <span>Payment held in escrow until departure date</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style>
  .checkout-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .checkout-header {
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .trust-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .checkout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 960px) {
    .checkout-grid {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .form-section {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sec-title {
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-fog);
    padding-bottom: var(--space-2);
  }

  .fields-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .fields-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .f-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .f-group label {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .f-group input,
  .f-group textarea,
  .f-group select {
    padding: 12px;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    font-size: var(--text-sm);
  }

  .payment-tabs {
    display: flex;
    gap: var(--space-3);
  }

  .pay-method-pill {
    flex: 1;
    padding: 12px;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    background-color: var(--color-fog);
  }

  .pay-method-pill.active {
    border-color: var(--color-ink);
    background-color: var(--color-canvas);
  }

  .pay-method-pill input {
    display: none;
  }

  .btn-block {
    width: 100%;
    padding: 16px;
  }

  .micro-guarantee {
    font-size: 11px;
    color: var(--color-mist);
    text-align: center;
    margin-top: 4px;
  }

  .summary-card {
    position: sticky;
    top: 96px;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .summary-title {
    font-size: var(--text-lg);
  }

  .product-thumb {
    display: flex;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-fog);
    padding-bottom: var(--space-4);
  }

  .product-thumb img {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .prod-type {
    font-size: 10px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-swiss-accent);
    font-weight: 600;
  }

  .prod-name {
    font-size: var(--text-sm);
    line-height: 1.3;
    margin: 2px 0;
  }

  .prod-date {
    font-size: 11px;
    color: var(--color-mist);
  }

  .cost-breakdown {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-xs);
  }

  .cost-breakdown .line {
    display: flex;
    justify-content: space-between;
    color: var(--color-mist);
  }

  .free-tag {
    color: var(--color-success);
    font-weight: 600;
  }

  .total-line {
    border-top: 1px solid var(--color-fog);
    padding-top: var(--space-3);
    color: var(--color-ink) !important;
    font-size: var(--text-base) !important;
  }

  .operator-badge-box {
    background-color: var(--color-fog);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-size: 11px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
</style>
