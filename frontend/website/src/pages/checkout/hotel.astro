---
import Layout from '@layouts/Layout.astro';
import { HOTEL_ARRIVAL_SLOTS } from '@shared/data/dynamic-options';
---

<Layout 
  title="Hotel & Chalet Checkout — TravellerAI" 
  description="Confirm your room reservation with instant PMS lock and digital check-in."
>
  <div class="checkout-page">
    <div class="container">
      <div class="checkout-header">
        <span class="editorial-tag">PMS Integration</span>
        <h1 class="page-title">Hotel Reservation Checkout</h1>
        <div class="trust-pill-row">
          <span class="badge badge-success">✓ Instant Room Lock</span>
          <span class="badge badge-neutral">Digital Mobile Key Ready</span>
          <span class="badge badge-neutral">Free Cancellation up to 48h</span>
        </div>
      </div>

      <div class="checkout-grid">
        <div class="checkout-form-col">
          <form class="checkout-form" onsubmit="event.preventDefault(); window.location.href = '/checkout/confirmation?type=hotel';">
            <section class="form-section">
              <h2 class="sec-title">1. Guest Details</h2>
              <div class="fields-row">
                <div class="f-group">
                  <label for="g-first">First Name</label>
                  <input id="g-first" type="text" required placeholder="First Name" />
                </div>
                <div class="f-group">
                  <label for="g-last">Last Name</label>
                  <input id="g-last" type="text" required placeholder="Last Name" />
                </div>
              </div>
              <div class="fields-row">
                <div class="f-group">
                  <label for="g-email">Confirmation Email</label>
                  <input id="g-email" type="email" required placeholder="email@domain.com" />
                </div>
                <div class="f-group">
                  <label for="g-arrival">Estimated Arrival Time</label>
                  <select id="g-arrival">
                    {HOTEL_ARRIVAL_SLOTS.map((slot) => (
                      <option value={slot.value}>{slot.label}</option>
                    ))}
                  </select>
                </div>
              </div>
            </section>

            <section class="form-section">
              <h2 class="sec-title">2. Payment Method</h2>
              <div class="f-group">
                <label for="card-num">Card Number</label>
                <input id="card-num" type="text" value="4242 •••• •••• 4242" />
              </div>
              <div class="fields-row">
                <div class="f-group">
                  <label for="exp">Expiry</label>
                  <input id="exp" type="text" value="12/28" />
                </div>
                <div class="f-group">
                  <label for="cvc">CVC</label>
                  <input id="cvc" type="text" value="888" />
                </div>
              </div>
            </section>

            <button type="submit" class="btn btn-primary btn-lg btn-block">
              Complete Hotel Reservation
            </button>
          </form>
        </div>

        <aside class="checkout-summary-col">
          <div class="summary-card">
            <h3 class="summary-title">Stay Overview</h3>
            <div class="product-thumb">
              <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=400&auto=format&fit=crop" alt="Matterhorn Chalet" />
              <div>
                <span class="prod-type">Alpine Sanctuary</span>
                <h4 class="prod-name">The Matterhorn Sanctuary & Spa Chalet</h4>
                <span class="prod-date">4 Nights • Oct 14 – Oct 18, 2026</span>
              </div>
            </div>

            <div class="cost-breakdown">
              <div class="line">
                <span>Matterhorn Panorama Suite ($620 × 4)</span>
                <span>$2,480.00</span>
              </div>
              <div class="line">
                <span>Local Resort Tourist Tax</span>
                <span>$32.00</span>
              </div>
              <div class="line">
                <span>Booking Fee</span>
                <span class="free-tag">$0.00 (FREE)</span>
              </div>
              <div class="line total-line">
                <strong>Total Rate:</strong>
                <strong>$2,512.00 USD</strong>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style>
  .checkout-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .checkout-header {
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .trust-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .checkout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 960px) {
    .checkout-grid {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .form-section {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sec-title {
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-fog);
    padding-bottom: var(--space-2);
  }

  .fields-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .fields-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .f-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .f-group label {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .f-group input,
  .f-group select {
    padding: 12px;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    font-size: var(--text-sm);
  }

  .btn-block {
    width: 100%;
    padding: 16px;
  }

  .summary-card {
    position: sticky;
    top: 96px;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .summary-title {
    font-size: var(--text-lg);
  }

  .product-thumb {
    display: flex;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-fog);
    padding-bottom: var(--space-4);
  }

  .product-thumb img {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .prod-type {
    font-size: 10px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-swiss-accent);
    font-weight: 600;
  }

  .prod-name {
    font-size: var(--text-sm);
    line-height: 1.3;
    margin: 2px 0;
  }

  .prod-date {
    font-size: 11px;
    color: var(--color-mist);
  }

  .cost-breakdown {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-xs);
  }

  .cost-breakdown .line {
    display: flex;
    justify-content: space-between;
    color: var(--color-mist);
  }

  .free-tag {
    color: var(--color-success);
    font-weight: 600;
  }

  .total-line {
    border-top: 1px solid var(--color-fog);
    padding-top: var(--space-3);
    color: var(--color-ink) !important;
    font-size: var(--text-base) !important;
  }
</style>
