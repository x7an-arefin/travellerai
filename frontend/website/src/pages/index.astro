---
import Layout from '@layouts/Layout.astro';
import { getTours } from '@modules/tours/tours.controller';
import { getHotels } from '@modules/hotels/hotels.controller';
import { getVehicles } from '@modules/vehicles/vehicles.controller';
import { getDestinations } from '@modules/destinations/destinations.model';
import TourCard from '@modules/tours/components/TourCard.astro';
import HotelCard from '@modules/hotels/components/HotelCard.astro';
import VehicleCard from '@modules/vehicles/components/VehicleCard.astro';
import UnifiedHeroSearch from '@modules/home/components/islands/UnifiedHeroSearch';

// Parallel fetching via controllers (Supports API / Mock dataMode)
const [tours, hotels, vehicles, destinations] = await Promise.all([
  getTours(),
  getHotels(),
  getVehicles(),
  getDestinations(),
]);
---

<Layout 
  title="The Unified Independent Travel Marketplace" 
  description="Discover vetted boutique expeditions, secluded mountain chalets, and executive transport fleets. Direct booking with verified independent operators worldwide."
>
  <!-- Hero Section: Swiss Modern Typographic Authority + Unified Search Island -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-header">
        <div class="hero-badge">
          <span class="pill-dot"></span>
          <span class="pill-text">Direct Operator Marketplace • Zero Aggregator Hidden Fees</span>
        </div>
        <h1 class="hero-title">
          Curated journeys.<br />
          <span class="hero-italic">Direct from the creators.</span>
        </h1>
        <p class="hero-lead">
          Connect directly with vetted mountain guides, historic sanctuaries, and executive transport fleets. One unified surface engineered for uncompromising clarity.
        </p>
      </div>

      <!-- SolidJS Island: Unified Multi-Product Search Matrix with Client-Side Tab Switching & Clean SEO URLs -->
      <UnifiedHeroSearch client:load />

      <!-- Social Proof Stats Row (Labor Illusion & Trust Anchoring) -->
      <div class="trust-metrics-row">
        <div class="metric-item">
          <span class="metric-val">100%</span>
          <span class="metric-lbl">Verified Local Operators</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val">4.96/5</span>
          <span class="metric-lbl">Average Traveler Rating</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val">Zero</span>
          <span class="metric-lbl">Hidden Aggregator Fees</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val">24/7</span>
          <span class="metric-lbl">Dedicated Concierge Desk</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Destinations Section -->
  <section class="destinations-section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="editorial-tag">Regional Curations</span>
          <h2 class="section-title">Iconic Destinations</h2>
        </div>
        <a href="/destinations" class="editorial-view-all">
          All Destinations ({destinations.length}) <span>→</span>
        </a>
      </div>

      <div class="destinations-grid">
        {destinations.map((dest) => (
          <a href={`/destinations/${dest.slug}`} class="destination-card">
            <img src={dest.featuredImage} alt={dest.name} loading="lazy" />
            <div class="dest-card-overlay">
              <span class="dest-region">{dest.region}</span>
              <h3 class="dest-name">{dest.name}</h3>
              <p class="dest-meta">{dest.toursCount} Tours • {dest.hotelsCount} Sanctuaries</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Curated Expeditions Showcase -->
  <section class="catalog-section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="editorial-tag">Handcrafted Itineraries</span>
          <h2 class="section-title">Featured Expeditions</h2>
        </div>
        <a href="/tours" class="editorial-view-all">
          Explore All Tours <span>→</span>
        </a>
      </div>

      <div class="cards-grid">
        {tours.map((tour) => (
          <TourCard tour={tour} />
        ))}
      </div>
    </div>
  </section>

  <!-- Hotels & Sanctuaries Showcase -->
  <section class="catalog-section bg-fog">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="editorial-tag">Architectural Stays</span>
          <h2 class="section-title">Boutique Sanctuaries & Chalets</h2>
        </div>
        <a href="/hotels" class="editorial-view-all">
          Explore All Accommodations <span>→</span>
        </a>
      </div>

      <div class="cards-grid">
        {hotels.map((hotel) => (
          <HotelCard hotel={hotel} />
        ))}
      </div>
    </div>
  </section>

  <!-- Fleet & Transport Showcase -->
  <section class="catalog-section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="editorial-tag">Precision Transit</span>
          <h2 class="section-title">Executive Fleet & Transfers</h2>
        </div>
        <a href="/vehicles" class="editorial-view-all">
          Explore All Vehicles <span>→</span>
        </a>
      </div>

      <div class="cards-grid">
        {vehicles.map((vehicle) => (
          <VehicleCard vehicle={vehicle} />
        ))}
      </div>
    </div>
  </section>

  <!-- Provider Call to Action (Asymmetric Swiss Modern Split) -->
  <section class="provider-banner-section">
    <div class="container">
      <div class="provider-banner-card">
        <div class="banner-content">
          <span class="editorial-tag" style="color: var(--color-fog);">For Independent Operators</span>
          <h2 class="banner-title">Build your travel business on your own terms.</h2>
          <p class="banner-desc">
            Take direct bookings, manage hotel rooms via our automated PMS, and dispatch fleet operations with zero commission lock-ins.
          </p>
          <div class="banner-actions">
            <a href="/provider" class="btn btn-primary">
              Partner Overview & Benefits
            </a>
            <a href="http://localhost:4200" class="btn btn-secondary" target="_blank" rel="noopener" style="border-color: rgba(255,255,255,0.3); color: #fff;">
              Direct Portal Login
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Typography & Layout */
  .hero-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-stone);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .hero-header {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background-color: var(--color-fog);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-full);
    width: fit-content;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-swiss-accent);
  }

  .hero-title {
    font-size: var(--text-hero);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 800;
  }

  .hero-italic {
    font-family: var(--font-accent);
    font-weight: 400;
    font-style: italic;
    color: var(--color-graphite);
  }

  .hero-lead {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-mist);
    max-width: 680px;
  }

  /* Multi-Product Search Matrix Styling (Consumed by Island) */
  :global(.search-matrix-card) {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.matrix-tabs) {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-fog);
    padding-bottom: var(--space-2);
    overflow-x: auto;
  }

  :global(.matrix-tab) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-mist);
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  :global(.matrix-tab:hover) {
    color: var(--color-ink);
    background-color: var(--color-fog);
  }

  :global(.matrix-tab.active) {
    color: var(--color-ink);
    background-color: var(--color-fog);
  }

  :global(.search-form-row) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 960px) {
    :global(.search-form-row) {
      grid-template-columns: 2fr 1.5fr 1.5fr auto;
      align-items: end;
    }
  }

  :global(.search-input-group) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.search-input-group label) {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mist);
  }

  :global(.search-input-group input),
  :global(.search-input-group select) {
    padding: 12px 14px;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    color: var(--color-ink);
  }

  :global(.search-input-group input:focus),
  :global(.search-input-group select:focus) {
    border-color: var(--color-ink);
    outline: none;
  }

  :global(.search-submit-btn) {
    height: 44px;
  }

  /* Trust Metrics Row */
  .trust-metrics-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-4);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
  }

  .metric-lbl {
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  .metric-sep {
    width: 1px;
    height: 28px;
    background-color: var(--color-stone);
    display: none;
  }

  @media (min-width: 640px) {
    .metric-sep {
      display: block;
    }
  }

  /* Catalog Sections */
  .catalog-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .bg-fog {
    background-color: var(--color-fog);
  }

  .section-heading-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: var(--text-3xl);
    margin-top: 4px;
  }

  .editorial-view-all {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .editorial-view-all:hover {
    color: var(--color-swiss-accent);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Destination Grid */
  .destinations-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .destinations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .destinations-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .destination-card {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-charcoal);
  }

  .destination-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease-out;
  }

  .destination-card:hover img {
    transform: scale(1.06);
  }

  .dest-card-overlay {
    position: absolute;
    inset: 0;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.85) 100%);
    color: #ffffff;
  }

  .dest-region {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    color: #d4d4d8;
  }

  .dest-name {
    font-size: var(--text-lg);
    color: #ffffff;
    font-weight: 700;
  }

  .dest-meta {
    font-size: var(--text-xs);
    color: #a1a1aa;
    margin-top: 2px;
  }

  /* Provider Call to Action */
  .provider-banner-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .provider-banner-card {
    background-color: var(--color-ink);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
    color: var(--color-canvas);
  }

  @media (min-width: 768px) {
    .provider-banner-card {
      padding: var(--space-16) var(--space-12);
    }
  }

  .banner-content {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .banner-title {
    color: var(--color-canvas);
    font-size: var(--text-4xl);
    line-height: 1.15;
  }

  .banner-desc {
    color: #a1a1aa;
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .banner-actions .btn-primary {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-color: var(--color-canvas);
  }

  .banner-actions .btn-primary:hover {
    background-color: #ffffff;
  }
</style>
