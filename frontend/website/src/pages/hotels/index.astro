---
import Layout from '@layouts/Layout.astro';
import { getHotels } from '@modules/hotels/hotels.controller';
import HotelSearch from '@modules/hotels/components/islands/HotelSearch';

const hotels = await getHotels();
---

<Layout 
  title="Hotels, Chalets & Sanctuaries" 
  description="Boutique heritage ryokans, high-altitude alpine chalets, and secluded eco-villas with guaranteed live inventory and verified reviews."
>
  <div class="hotels-page">
    <div class="container">
      <div class="page-header">
        <span class="editorial-tag">Architectural Stays</span>
        <h1 class="page-title">Curated Sanctuaries & Hotels</h1>
        <p class="page-lead">
          From private onsen retreats in Kyoto to ski-in chalets facing the Matterhorn. Book directly with boutique hoteliers.
        </p>
      </div>

      <!-- SolidJS Island: Interactive Hotel Filter & Live Search -->
      <HotelSearch client:load initialHotels={hotels} />
    </div>
  </div>
</Layout>

<style>
  .hotels-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .page-header {
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .page-lead {
    font-size: var(--text-base);
    color: var(--color-mist);
    max-width: 620px;
  }
</style>
