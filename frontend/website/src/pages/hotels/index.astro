---
import Layout from '@layouts/Layout.astro';
import { getHotels } from '@modules/hotels/hotels.controller';
import HotelSearch from '@modules/hotels/components/islands/HotelSearch';

const hotels = await getHotels();
---

<Layout 
  title="Hotels, Chalets & Sanctuaries" 
  description="Boutique heritage ryokans, high-altitude alpine chalets, and secluded eco-villas with guaranteed live inventory and verified reviews."
>
  <div class="hotels-page">
    <div class="container">
      <div class="page-header">
        <span class="editorial-tag">Architectural Stays</span>
        <h1 class="page-title">Curated Sanctuaries & Hotels</h1>
        <p class="page-lead">
          From private onsen retreats in Kyoto to ski-in chalets facing the Matterhorn. Book directly with boutique hoteliers.
        </p>
      </div>

      <!-- SolidJS Island: Interactive Hotel Filter & Live Search -->
      <HotelSearch client:load initialHotels={hotels} />
    </div>
  </div>
</Layout>

<style>
  .hotels-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .page-header {
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .page-lead {
    font-size: var(--text-base);
    color: var(--color-mist);
    max-width: 620px;
  }

  /* Global Styles for Hotel Island */
  :global(.hotels-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    :global(.hotels-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    :global(.hotels-grid) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  :global(.hotel-card) {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  :global(.hotel-card:hover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-graphite);
  }

  :global(.card-address) {
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  :global(.location-stars) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.location-name) {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-graphite);
  }

  :global(.star-rating) {
    color: #f59e0b;
    font-size: 11px;
    letter-spacing: 1px;
  }

  :global(.rating-box) {
    background-color: var(--color-ink);
    color: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  :global(.amenities-pills) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  :global(.amenity-pill) {
    font-size: 11px;
    background-color: var(--color-fog);
    color: var(--color-graphite);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-stone);
  }

  :global(.night-label) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mist);
    display: block;
  }

  :global(.price-val) {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  :global(.price-val .currency) {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  :global(.price-val .num) {
    font-size: var(--text-xl);
    font-weight: 800;
    font-family: var(--font-display);
  }

  :global(.price-val .tax-info) {
    font-size: 11px;
    color: var(--color-mist);
    margin-left: 4px;
  }

  :global(.checkbox-wrap) {
    display: flex;
    align-items: center;
    height: 100%;
    padding-top: 18px;
  }

  :global(.checkbox-label) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    cursor: pointer;
  }
</style>
