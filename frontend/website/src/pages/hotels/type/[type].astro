---
import Layout from '@layouts/Layout.astro';
import { getHotels } from '@modules/hotels/hotels.controller';
import HotelSearch from '@modules/hotels/components/islands/HotelSearch';

export async function getStaticPaths() {
  const types = ['alpine-chalet', 'heritage-ryokan', 'eco-villa', 'boutique-hotel'];
  const allHotels = await getHotels();
  
  return types.map((type) => ({
    params: { type },
    props: { 
      type,
      hotels: allHotels
    }
  }));
}

const { type, hotels } = Astro.props;

const typeTitles: Record<string, string> = {
  'alpine-chalet': 'Boutique Alpine Chalets & Lodges',
  'heritage-ryokan': 'Authentic Heritage Ryokans with Onsen',
  'eco-villa': 'Secluded Eco Villas & Tea Estate Bungalows',
  'boutique-hotel': 'Curated Boutique Design Hotels'
};

const title = typeTitles[type] || `${type} Sanctuaries`;
---

<Layout 
  title={`${title} | TravellerAI`}
  description={`Browse verified ${type} properties with transparent nightly rates, direct booking, and instant confirmation.`}
>
  <div class="hotels-page">
    <div class="container">
      <nav class="breadcrumb-nav">
        <a href="/">Home</a> / <a href="/hotels">Hotels</a> / <span>{type}</span>
      </nav>

      <div class="page-header">
        <span class="editorial-tag">Architectural Category</span>
        <h1 class="page-title">{title}</h1>
        <p class="page-lead">
          Direct reservations with independent hoteliers. Hand-selected for exceptional architectural character and tranquil settings.
        </p>
      </div>

      <HotelSearch client:load initialHotels={hotels} currentType={type} />
    </div>
  </div>
</Layout>

<style>
  .hotels-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .breadcrumb-nav {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-bottom: var(--space-4);
  }

  .breadcrumb-nav a {
    color: var(--color-mist);
  }

  .page-header {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .page-lead {
    font-size: var(--text-base);
    color: var(--color-mist);
    max-width: 620px;
  }
</style>
