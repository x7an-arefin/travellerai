---
import Layout from '@layouts/Layout.astro';
import { getTours } from '@modules/tours/tours.controller';
import TourSearch from '@modules/tours/components/islands/TourSearch';

const tours = await getTours();
---

<Layout 
  title="Curated Tours & Expeditions" 
  description="Explore vetted small-group adventures, high-altitude alpine traverses, and cultural heritage sanctuaries. Transparent pricing, verified operators."
>
  <div class="catalog-page">
    <div class="container">
      <div class="catalog-header">
        <span class="editorial-tag">Direct Marketplace</span>
        <h1 class="page-title">Curated Expeditions</h1>
        <p class="page-lead">
          Every journey is created and operated by vetted local specialists. Zero middleman markup, full price transparency.
        </p>
      </div>

      <!-- SolidJS Island: Interactive Filter Matrix & Real-time Live Search -->
      <TourSearch client:load initialTours={tours} />
    </div>
  </div>
</Layout>

<style>
  .catalog-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .catalog-header {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .page-lead {
    font-size: var(--text-base);
    color: var(--color-mist);
    max-width: 600px;
  }

  /* Global Styles for the TourSearch Island */
  :global(.filter-matrix-box) {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.category-pills-row) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-fog);
  }

  :global(.filter-pill) {
    padding: 8px 16px;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-full);
    background-color: var(--color-fog);
    color: var(--color-graphite);
    border: 1px solid var(--color-stone);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  :global(.filter-pill:hover) {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-color: var(--color-graphite);
  }

  :global(.filter-pill.active) {
    background-color: var(--color-ink);
    color: var(--color-canvas);
    border-color: var(--color-ink);
  }

  :global(.filter-inputs-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    :global(.filter-inputs-grid) {
      grid-template-columns: 2fr 1.5fr 1fr;
      align-items: center;
    }
  }

  :global(.input-wrap) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.input-wrap label) {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  :global(.input-wrap input),
  :global(.input-wrap select) {
    padding: 10px 12px;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    color: var(--color-ink);
  }

  :global(.results-header-meta) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  :global(.results-count-text) {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-mist);
  }

  :global(.results-count-text strong) {
    color: var(--color-ink);
  }

  :global(.tours-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    :global(.tours-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    :global(.tours-grid) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  :global(.empty-state-box) {
    grid-column: 1 / -1;
    background-color: var(--color-pure-white);
    border: 1px dashed var(--color-stone);
    border-radius: var(--radius-xl);
    padding: var(--space-12);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  :global(.tour-card) {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  :global(.tour-card:hover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-graphite);
  }

  :global(.card-media) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-fog);
  }

  :global(.card-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease-out;
  }

  :global(.tour-card:hover .card-media img) {
    transform: scale(1.04);
  }

  :global(.media-overlay) {
    position: absolute;
    inset: 0;
    padding: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, transparent 40%);
    pointer-events: none;
  }

  :global(.card-body) {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-3);
  }

  :global(.meta-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  :global(.destination-label) {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
    color: var(--color-graphite);
  }

  :global(.rating-badge) {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-ink);
  }

  :global(.rating-badge svg) {
    color: #f59e0b;
  }

  :global(.reviews-count) {
    color: var(--color-mist);
    font-weight: 400;
  }

  :global(.card-title) {
    font-size: var(--text-lg);
    line-height: 1.3;
    font-weight: 700;
  }

  :global(.card-title a:hover) {
    color: var(--color-swiss-accent);
  }

  :global(.card-subtitle) {
    font-size: var(--text-xs);
    color: var(--color-mist);
    line-height: 1.5;
  }

  :global(.highlights-preview) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-graphite);
  }

  :global(.highlight-item) {
    display: flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.bullet) {
    color: var(--color-mist);
    font-size: 8px;
  }

  :global(.card-footer) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-4);
    margin-top: auto;
    border-top: 1px solid var(--color-fog);
  }

  :global(.price-from-label) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mist);
    display: block;
  }

  :global(.price-amount) {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  :global(.price-amount .currency) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  :global(.price-amount .value) {
    font-size: var(--text-xl);
    font-weight: 800;
    font-family: var(--font-display);
    color: var(--color-ink);
  }

  :global(.price-amount .per-person) {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-left: 2px;
  }
</style>
