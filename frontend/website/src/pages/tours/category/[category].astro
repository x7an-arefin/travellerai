---
import Layout from '@layouts/Layout.astro';
import { getTours } from '@modules/tours/tours.controller';
import TourSearch from '@modules/tours/components/islands/TourSearch';

export async function getStaticPaths() {
  const categories = ['adventure', 'cultural', 'wildlife', 'luxury', 'culinary'];
  const allTours = await getTours();
  
  return categories.map((cat) => ({
    params: { category: cat },
    props: { 
      category: cat,
      tours: allTours
    }
  }));
}

const { category, tours } = Astro.props;

const categoryTitles: Record<string, string> = {
  adventure: 'High Altitude & Alpine Adventure Tours',
  cultural: 'Cultural Heritage & Ancient Sanctuary Expeditions',
  wildlife: 'Wildlife Tracking & Rainforest Expeditions',
  luxury: 'Private Luxury & Boutique Travel',
  culinary: 'Gastronomy & Artisanal Food Journeys'
};

const title = categoryTitles[category] || `${category.toUpperCase()} Expeditions`;
---

<Layout 
  title={`${title} | Direct Marketplace`}
  description={`Discover curated ${category} travel packages and itineraries operated by verified independent specialists.`}
>
  <div class="catalog-page">
    <div class="container">
      <nav class="breadcrumb-nav">
        <a href="/">Home</a> / <a href="/tours">Tours</a> / <span>{category}</span>
      </nav>

      <div class="catalog-header">
        <span class="editorial-tag">Specialized Category</span>
        <h1 class="page-title">{title}</h1>
        <p class="page-lead">
          Vetted itineraries focused on {category} immersion with certified local guides and transparent pricing.
        </p>
      </div>

      <TourSearch client:load initialTours={tours} currentCategory={category} />
    </div>
  </div>
</Layout>

<style>
  .catalog-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .breadcrumb-nav {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-bottom: var(--space-4);
  }

  .breadcrumb-nav a {
    color: var(--color-mist);
  }

  .catalog-header {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .page-lead {
    font-size: var(--text-base);
    color: var(--color-mist);
    max-width: 600px;
  }
</style>
