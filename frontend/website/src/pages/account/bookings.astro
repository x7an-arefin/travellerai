---
import Layout from '@layouts/Layout.astro';
---

<Layout title="My Tour Bookings — TravellerAI" description="View and manage tour departure vouchers.">
  <div class="account-page">
    <div class="container">
      <header class="account-header">
        <h1 class="page-title">Tour Bookings & Vouchers</h1>
        <nav class="account-nav-tabs">
          <a href="/account" class="tab-btn">Overview</a>
          <a href="/account/bookings" class="tab-btn active">Tours (1)</a>
          <a href="/account/reservations" class="tab-btn">Hotels (1)</a>
          <a href="/account/rentals" class="tab-btn">Rentals (1)</a>
          <a href="/account/wishlist" class="tab-btn">Wishlist (4)</a>
        </nav>
      </header>

      <div class="bookings-list">
        <article class="booking-item-card">
          <div class="item-media">
            <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=400&auto=format&fit=crop" alt="Swiss Alps" />
          </div>
          <div class="item-content">
            <div class="badge-row">
              <span class="badge badge-success">✓ Escrow Confirmed</span>
              <span class="booking-id">Code: #TRAV-2026-9481</span>
            </div>
            <h2>Swiss Alpine Odyssey & Glacier Express</h2>
            <p class="meta">Oct 12 – 18, 2026 • 2 Adults • Operated by Helvetia Alpine Expeditions</p>
            <div class="price-paid">
              <span>Paid in Full:</span> <strong>$7,200.00 USD</strong>
            </div>
            <div class="item-actions">
              <button class="btn btn-primary btn-sm" onclick="window.print()">Print Official Voucher</button>
              <a href="/contact?ref=TRAV-2026-9481" class="btn btn-secondary btn-sm">Message Mountain Guide</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</Layout>

<style>
  .account-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .account-header {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .page-title {
    font-size: var(--text-3xl);
  }

  .account-nav-tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-stone);
    padding-bottom: var(--space-2);
  }

  .tab-btn {
    padding: 8px 16px;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-md);
    color: var(--color-mist);
  }

  .tab-btn.active {
    color: var(--color-ink);
    background-color: var(--color-fog);
  }

  .bookings-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .booking-item-card {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .booking-item-card {
      grid-template-columns: 240px 1fr;
      align-items: center;
    }
  }

  .item-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .item-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .badge-row {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .booking-id {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mist);
  }

  .item-content h2 {
    font-size: var(--text-xl);
  }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  .price-paid {
    font-size: var(--text-sm);
  }

  .item-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
