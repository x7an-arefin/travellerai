---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Hotel Reservations — TravellerAI" description="View hotel room reservations and access express digital check-in QR codes.">
  <div class="account-page">
    <div class="container">
      <header class="account-header">
        <h1 class="page-title">Hotel & Chalet Reservations</h1>
        <nav class="account-nav-tabs">
          <a href="/account" class="tab-btn">Overview</a>
          <a href="/account/bookings" class="tab-btn">Tours (1)</a>
          <a href="/account/reservations" class="tab-btn active">Hotels (1)</a>
          <a href="/account/rentals" class="tab-btn">Rentals (1)</a>
          <a href="/account/wishlist" class="tab-btn">Wishlist (4)</a>
        </nav>
      </header>

      <div class="bookings-list">
        <article class="booking-item-card">
          <div class="item-media">
            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=400&auto=format&fit=crop" alt="Chalet" />
          </div>
          <div class="item-content">
            <div class="badge-row">
              <span class="badge badge-success">✓ PMS Locked</span>
              <span class="booking-id">Folio: #PMS-ZMT-8819</span>
            </div>
            <h2>The Matterhorn Sanctuary & Spa Chalet</h2>
            <p class="meta">Oct 14 – 18, 2026 (4 Nights) • Matterhorn Panorama Suite • Zermatt, Switzerland</p>
            <div class="price-paid">
              <span>Total Folio Amount:</span> <strong>$2,512.00 USD</strong>
            </div>
            <div class="item-actions">
              <button class="btn btn-primary btn-sm" onclick="alert('Digital Check-in QR: Scan at property terminal for instant room access.');">
                Express Digital Check-in QR
              </button>
              <a href="/hotels/the-matterhorn-sanctuary" class="btn btn-secondary btn-sm">Property Guide</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</Layout>

<style>
  .account-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .account-header {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .page-title {
    font-size: var(--text-3xl);
  }

  .account-nav-tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-stone);
    padding-bottom: var(--space-2);
  }

  .tab-btn {
    padding: 8px 16px;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-md);
    color: var(--color-mist);
  }

  .tab-btn.active {
    color: var(--color-ink);
    background-color: var(--color-fog);
  }

  .bookings-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .booking-item-card {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .booking-item-card {
      grid-template-columns: 240px 1fr;
      align-items: center;
    }
  }

  .item-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .item-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .badge-row {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .booking-id {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mist);
  }

  .item-content h2 {
    font-size: var(--text-xl);
  }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  .price-paid {
    font-size: var(--text-sm);
  }

  .item-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
