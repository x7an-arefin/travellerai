---
import Layout from '@layouts/Layout.astro';
import { getTransfers } from '@modules/transfers/transfers.model';

export async function getStaticPaths() {
  const transfers = await getTransfers();
  return transfers.map((transfer) => ({
    params: { slug: transfer.slug },
    props: { transfer }
  }));
}

const { transfer } = Astro.props;
---

<Layout 
  title={`VIP Transfer: ${transfer.origin} to ${transfer.destination}`}
  description={`Book fixed-rate chauffeured transfer from ${transfer.origin} to ${transfer.destination} in a luxury ${transfer.vehicleModel}.`}
  ogImage={transfer.featuredImage}
>
  <div class="transfer-detail-page">
    <div class="container">
      <nav class="breadcrumb-nav">
        <a href="/">Home</a> / <a href="/vehicles">Fleet</a> / <a href="/vehicles/transfers">Transfers</a> / <span>{transfer.slug}</span>
      </nav>

      <header class="transfer-header">
        <div class="badges-row">
          <span class="badge badge-neutral">{transfer.vehicleClass}</span>
          <span class="badge badge-accent">Fixed All-Inclusive Rate</span>
        </div>
        <h1 class="transfer-title">{transfer.origin} <span>→</span> {transfer.destination}</h1>
        <p class="transfer-meta">Direct Chauffeured Service • Operated by {transfer.providerName}</p>
      </header>

      <div class="transfer-grid-layout">
        <div class="main-info">
          <div class="hero-image-wrap">
            <img src={transfer.featuredImage} alt={transfer.origin} />
          </div>

          <section class="section-block">
            <h2>Route Details & Inclusions</h2>
            <div class="route-metrics-bar">
              <div class="m-cell">
                <span class="m-lbl">Distance</span>
                <span class="m-val">{transfer.distanceKm} Kilometers</span>
              </div>
              <div class="m-cell">
                <span class="m-lbl">Travel Time</span>
                <span class="m-val">~{transfer.durationMinutes} Minutes</span>
              </div>
              <div class="m-cell">
                <span class="m-lbl">Vehicle</span>
                <span class="m-val">{transfer.vehicleModel}</span>
              </div>
            </div>

            <ul class="inc-list">
              {transfer.includedAmenities.map((item) => (
                <li><span>✓</span> {item}</li>
              ))}
            </ul>
          </section>
        </div>

        <aside class="sidebar-box">
          <div class="booking-box">
            <div class="price-header">
              <span class="label">Fixed Rate</span>
              <div class="price">
                <span class="val">${transfer.fixedRate}</span>
                <span class="sub">USD (Total)</span>
              </div>
            </div>

            <form class="input-stack" onsubmit="event.preventDefault(); window.location.href='/checkout/vehicle';">
              <div class="input-grp">
                <label>Flight Number or Arrival Time</label>
                <input type="text" placeholder="e.g. LX 18, 14:30" required />
              </div>
              <div class="input-grp">
                <label>Pickup Date</label>
                <input type="date" value="2026-10-14" required />
              </div>
              <div class="input-grp">
                <label>Passengers</label>
                <select>
                  <option>1-2 Passengers</option>
                  <option>3-4 Passengers</option>
                  <option>5-7 Passengers (Van)</option>
                </select>
              </div>

              <button type="submit" class="btn btn-primary btn-block">
                Confirm VIP Transfer
              </button>
            </form>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style>
  .transfer-detail-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .breadcrumb-nav {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-bottom: var(--space-4);
  }

  .breadcrumb-nav a {
    color: var(--color-mist);
  }

  .transfer-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .badges-row {
    display: flex;
    gap: 8px;
  }

  .transfer-title {
    font-size: var(--text-4xl);
  }

  .transfer-meta {
    font-size: var(--text-sm);
    color: var(--color-mist);
  }

  .transfer-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 960px) {
    .transfer-grid-layout {
      grid-template-columns: 1.8fr 1fr;
      align-items: start;
    }
  }

  .hero-image-wrap {
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-6);
  }

  .hero-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .route-metrics-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background-color: var(--color-fog);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .m-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-lbl {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .m-val {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .inc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .inc-list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .inc-list span {
    color: var(--color-success);
    font-weight: 800;
  }

  .booking-box {
    position: sticky;
    top: 96px;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .price-header .label {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .price .val {
    font-size: var(--text-3xl);
    font-weight: 800;
  }

  .price .sub {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-left: 4px;
  }

  .input-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .input-grp {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .input-grp label {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .input-grp input,
  .input-grp select {
    padding: 10px 12px;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
  }

  .btn-block {
    width: 100%;
    padding: 14px;
  }
</style>
