---
import Layout from '@layouts/Layout.astro';
import { getVehicles } from '@modules/vehicles/vehicles.controller';
import VehicleSearch from '@modules/vehicles/components/islands/VehicleSearch';

const vehicles = await getVehicles();
---

<Layout 
  title="Executive Fleet & Airport Transfers" 
  description="Rent luxury SUVs, high-performance electric sedans, and chauffeured executive vans. Comprehensive zero-excess protection and door-to-door concierge delivery."
>
  <div class="fleet-page">
    <div class="container">
      <div class="page-header">
        <div class="header-actions-row">
          <div>
            <span class="editorial-tag">Precision Transit</span>
            <h1 class="page-title">Executive Fleet & Transfers</h1>
          </div>
          <a href="/vehicles/transfers" class="btn btn-secondary btn-sm">
            View Fixed Airport Routes →
          </a>
        </div>
        <p class="page-lead">
          Direct hire from licensed premium fleet operators. Airport meet-and-greet, unlimited mileage options, and transparent damage waivers.
        </p>
      </div>

      <!-- SolidJS Island: Interactive Vehicle Search & Filter -->
      <VehicleSearch client:load initialVehicles={vehicles} />
    </div>
  </div>
</Layout>

<style>
  .fleet-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .page-header {
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .header-actions-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .page-lead {
    font-size: var(--text-base);
    color: var(--color-mist);
    max-width: 620px;
  }

  /* Global Styles for Vehicle Island */
  :global(.fleet-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    :global(.fleet-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    :global(.fleet-grid) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  :global(.vehicle-card) {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  :global(.vehicle-card:hover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-graphite);
  }

  :global(.category-name) {
    font-weight: 600;
    color: var(--color-graphite);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  :global(.location-tag) {
    color: var(--color-mist);
  }

  :global(.specs-grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    padding: var(--space-3);
    background-color: var(--color-fog);
    border-radius: var(--radius-md);
    margin-top: 4px;
  }

  :global(.spec-item) {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--color-graphite);
  }

  :global(.spec-item svg) {
    color: var(--color-mist);
  }

  :global(.protection-note) {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--color-success);
    font-weight: 500;
  }

  :global(.day-label) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mist);
    display: block;
  }

  :global(.price-val .per-day) {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-left: 2px;
  }
</style>
