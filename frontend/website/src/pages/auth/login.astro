---
import Layout from '@layouts/Layout.astro';
---

<Layout 
  title="Traveler Sign In" 
  description="Sign in to your TravellerAI account to manage tour departures, hotel reservations, and rental vouchers."
>
  <div class="auth-page">
    <div class="container auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <a href="/" class="auth-logo">
            <span>TRAVELLER</span><span class="logo-accent">AI</span>
          </a>
          <h1 class="auth-title">Welcome Back</h1>
          <p class="auth-desc">Sign in to access your itinerary folios and verified reservations.</p>
        </div>

        <form class="auth-form" onsubmit="event.preventDefault(); alert('Signed in successfully!'); window.location.href = '/account';">
          <div class="form-field">
            <label for="email">Email Address</label>
            <input id="email" type="email" required placeholder="arefin@example.com" />
          </div>

          <div class="form-field">
            <div class="label-row">
              <label for="password">Password</label>
              <a href="/auth/forgot-password" class="forgot-link">Forgot?</a>
            </div>
            <input id="password" type="password" required placeholder="••••••••••••" />
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Sign In to Account
          </button>

          <div class="auth-divider">
            <span>or sign in with</span>
          </div>

          <button type="button" class="btn btn-secondary btn-block" onclick="alert('Google Auth integration simulation'); window.location.href = '/account';">
            Continue with Google
          </button>
        </form>

        <div class="auth-footer">
          <span>New to TravellerAI?</span>
          <a href="/auth/register">Create Traveler Account →</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-page {
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 180px);
  }

  .auth-container {
    display: flex;
    justify-content: center;
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .auth-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .auth-logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .logo-accent {
    font-family: var(--font-mono);
    color: var(--color-swiss-accent);
  }

  .auth-title {
    font-size: var(--text-2xl);
  }

  .auth-desc {
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .forgot-link {
    font-size: 11px;
    color: var(--color-swiss-accent);
  }

  .form-field input {
    padding: 12px;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    font-size: var(--text-sm);
  }

  .btn-block {
    width: 100%;
    padding: 12px;
  }

  .auth-divider {
    text-align: center;
    position: relative;
    margin: var(--space-2) 0;
  }

  .auth-divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-stone);
  }

  .auth-divider span {
    position: relative;
    background-color: var(--color-pure-white);
    padding: 0 10px;
    font-size: 11px;
    color: var(--color-mist);
  }

  .auth-footer {
    display: flex;
    justify-content: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--color-mist);
    border-top: 1px solid var(--color-fog);
    padding-top: var(--space-4);
  }

  .auth-footer a {
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
