---
import Layout from '@layouts/Layout.astro';
---

<Layout 
  title="Password Reset — TravellerAI" 
  description="Reset your account password via secure email verification."
>
  <div class="auth-page">
    <div class="container auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <h1 class="auth-title">Reset Password</h1>
          <p class="auth-desc">Enter your email address to receive a secure recovery link.</p>
        </div>

        <form class="auth-form" onsubmit="event.preventDefault(); alert('Password reset link sent to your inbox!'); window.location.href = '/auth/login';">
          <div class="form-field">
            <label for="reset-email">Registered Email</label>
            <input id="reset-email" type="email" class="shadcn-input" required placeholder="arefin@example.com" />
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Send Recovery Link
          </button>
        </form>

        <div class="auth-footer">
          <a href="/auth/login">← Back to Sign In</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-page {
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-container {
    display: flex;
    justify-content: center;
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .auth-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .auth-title {
    font-size: var(--text-2xl);
  }

  .auth-desc {
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .form-field input {
    padding: 12px;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    font-size: var(--text-sm);
  }

  .btn-block {
    width: 100%;
    padding: 12px;
  }

  .auth-footer {
    border-top: 1px solid var(--color-fog);
    padding-top: var(--space-4);
    text-align: center;
  }

  .auth-footer a {
    font-size: var(--text-xs);
    color: var(--color-ink);
  }
</style>
