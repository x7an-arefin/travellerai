---
import Layout from '@layouts/Layout.astro';
---

<Layout 
  title="Create Traveler Account" 
  description="Join TravellerAI to bookmark high-altitude expeditions, access direct operator rates, and manage bookings."
>
  <div class="auth-page">
    <div class="container auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <a href="/" class="auth-logo">
            <span>TRAVELLER</span><span class="logo-accent">AI</span>
          </a>
          <h1 class="auth-title">Create Account</h1>
          <p class="auth-desc">Join the direct-booking travel marketplace.</p>
        </div>

        <form class="auth-form" onsubmit="event.preventDefault(); alert('Account registered!'); window.location.href = '/account';">
          <div class="form-field">
            <label for="reg-name">Full Name</label>
            <input id="reg-name" type="text" class="shadcn-input" required placeholder="Sultanul Arefin" />
          </div>

          <div class="form-field">
            <label for="reg-email">Email Address</label>
            <input id="reg-email" type="email" class="shadcn-input" required placeholder="arefin@example.com" />
          </div>

          <div class="form-field">
            <label for="reg-password">Password</label>
            <input id="reg-password" type="password" class="shadcn-input" required placeholder="Minimum 8 characters" minlength="8" />
          </div>

          <div class="terms-row">
            <input id="reg-terms" type="checkbox" required />
            <label for="reg-terms">
              I agree to the <a href="/legal/terms">Terms of Service</a> & <a href="/legal/privacy">Privacy Policy</a>.
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Complete Registration
          </button>
        </form>

        <div class="auth-footer">
          <span>Already have an account?</span>
          <a href="/auth/login">Sign In →</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-page {
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 180px);
  }

  .auth-container {
    display: flex;
    justify-content: center;
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .auth-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .auth-logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .logo-accent {
    font-family: var(--font-mono);
    color: var(--color-swiss-accent);
  }

  .auth-title {
    font-size: var(--text-2xl);
  }

  .auth-desc {
    font-size: var(--text-xs);
    color: var(--color-mist);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .form-field input {
    padding: 12px;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    font-size: var(--text-sm);
  }

  .terms-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--color-mist);
  }

  .terms-row a {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .btn-block {
    width: 100%;
    padding: 12px;
  }

  .auth-footer {
    display: flex;
    justify-content: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--color-mist);
    border-top: 1px solid var(--color-fog);
    padding-top: var(--space-4);
  }

  .auth-footer a {
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
