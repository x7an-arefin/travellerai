---
import Layout from '@layouts/Layout.astro';
import { getDestinations } from '@modules/destinations/destinations.model';
import { getTours } from '@modules/tours/tours.controller';
import TourCard from '@modules/tours/components/TourCard.astro';

export async function getStaticPaths() {
  const destinations = await getDestinations();
  return destinations.map((d) => ({
    params: { slug: d.slug },
    props: { dest: d }
  }));
}

const { dest } = Astro.props;
const tours = await getTours({ destination: dest.slug });
---

<Layout 
  title={`${dest.name}, ${dest.country} Travel Guide`}
  description={dest.description}
  ogImage={dest.featuredImage}
>
  <div class="dest-single-page">
    <div class="container">
      <nav class="breadcrumb-nav">
        <a href="/">Home</a> / <a href="/destinations">Destinations</a> / <span>{dest.name}</span>
      </nav>

      <header class="dest-hero">
        <div class="hero-content">
          <span class="region-pill">{dest.region}</span>
          <h1 class="dest-title">{dest.name}</h1>
          <p class="dest-lead">{dest.description}</p>
          <div class="climate-badge">
            <strong>Optimal Season:</strong> {dest.bestTimeToVisit}
          </div>
        </div>
        <div class="hero-img-wrap">
          <img src={dest.featuredImage} alt={dest.name} />
        </div>
      </header>

      <section class="tours-section">
        <h2 class="section-title">Available Expeditions in {dest.name} ({tours.length})</h2>
        <div class="tours-grid">
          {tours.map(t => (
            <TourCard tour={t} />
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .dest-single-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .breadcrumb-nav {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-bottom: var(--space-6);
  }

  .breadcrumb-nav a {
    color: var(--color-mist);
  }

  .dest-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-16);
    background-color: var(--color-fog);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .dest-hero {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }
  }

  .hero-content {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .region-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .dest-title {
    font-size: var(--text-4xl);
  }

  .dest-lead {
    font-size: var(--text-base);
    color: var(--color-graphite);
    line-height: 1.6;
  }

  .climate-badge {
    background-color: var(--color-pure-white);
    padding: 8px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-stone);
    font-size: var(--text-xs);
    width: fit-content;
  }

  .hero-img-wrap {
    height: 100%;
    min-height: 320px;
  }

  .hero-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tours-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-title {
    font-size: var(--text-2xl);
  }

  .tours-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .tours-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .tours-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
