---
import type { VehicleItem } from '../vehicles.model';

interface Props {
  vehicle: VehicleItem;
}

const { vehicle } = Astro.props;
---

<article class="vehicle-card" data-vehicle-id={vehicle.id}>
  <div class="card-media">
    <img 
      src={vehicle.featuredImage} 
      alt={`${vehicle.make} ${vehicle.model}`}
      loading="lazy"
      decoding="async"
      width="600"
      height="400"
    />
    <div class="media-overlay">
      <span class="badge badge-neutral acriss-badge">{vehicle.acrissCode}</span>
      {vehicle.chauffeurAvailable && (
        <span class="badge badge-accent chauffeur-badge">Chauffeur Option</span>
      )}
    </div>
  </div>

  <div class="card-body">
    <div class="meta-row">
      <span class="category-name">{vehicle.category}</span>
      <span class="location-tag">{vehicle.cityLocation}</span>
    </div>

    <h3 class="card-title">
      <a href={`/vehicles/${vehicle.slug}`}>{vehicle.make} {vehicle.model}</a>
    </h3>

    <div class="specs-grid">
      <div class="spec-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
        </svg>
        <span>{vehicle.seats} Seats</span>
      </div>
      <div class="spec-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        <span>{vehicle.luggageCount} Bags</span>
      </div>
      <div class="spec-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{vehicle.transmission}</span>
      </div>
      <div class="spec-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="2" x2="12" y2="6"></line>
          <line x1="12" y1="18" x2="12" y2="22"></line>
          <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
          <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
          <line x1="2" y1="12" x2="6" y2="12"></line>
          <line x1="18" y1="12" x2="22" y2="12"></line>
        </svg>
        <span>{vehicle.fuelType}</span>
      </div>
    </div>

    <div class="protection-note">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span>Includes {vehicle.protectionTierIncluded}</span>
    </div>

    <div class="card-footer">
      <div class="price-block">
        <span class="day-label">Daily Rate</span>
        <div class="price-val">
          <span class="currency">$</span>
          <span class="num">{vehicle.dailyRate}</span>
          <span class="per-day">/ day</span>
        </div>
      </div>

      <a href={`/vehicles/${vehicle.slug}`} class="btn btn-primary btn-sm">
        Reserve Fleet
      </a>
    </div>
  </div>
</article>

<style>
  .vehicle-card {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .vehicle-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-graphite);
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-fog);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease-out;
  }

  .vehicle-card:hover .card-media img {
    transform: scale(1.04);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    padding: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, transparent 40%);
  }

  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-3);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
  }

  .category-name {
    font-weight: 600;
    color: var(--color-graphite);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .location-tag {
    color: var(--color-mist);
  }

  .card-title {
    font-size: var(--text-lg);
    line-height: 1.3;
    font-weight: 700;
  }

  .card-title a:hover {
    color: var(--color-swiss-accent);
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    padding: var(--space-3);
    background-color: var(--color-fog);
    border-radius: var(--radius-md);
    margin-top: 4px;
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--color-graphite);
  }

  .spec-item svg {
    color: var(--color-mist);
  }

  .protection-note {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--color-success);
    font-weight: 500;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-4);
    margin-top: auto;
    border-top: 1px solid var(--color-fog);
  }

  .day-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mist);
    display: block;
  }

  .price-val {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .price-val .currency {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .price-val .num {
    font-size: var(--text-xl);
    font-weight: 800;
    font-family: var(--font-display);
  }

  .price-val .per-day {
    font-size: var(--text-xs);
    color: var(--color-mist);
    margin-left: 2px;
  }

  .btn-sm {
    padding: 8px 14px;
    font-size: var(--text-xs);
  }
</style>
